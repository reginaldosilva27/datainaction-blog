---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---
<Base
  title="404 · Página não encontrada · DataInAction"
  description="A página que você procurou não existe ou foi movida. Volte para o blog e explore os artigos de dados e IA."
>
  <section class="notfound">
    <p class="nf-code" aria-hidden="true">404</p>
    <h1>Essa página não está no catálogo.</h1>
    <p class="nf-lead">
      O link pode ter mudado, expirado ou nunca ter existido — acontece nos melhores lakehouses.
      Mas tem muito conteúdo de dados e IA esperando por você.
    </p>
    <div class="nf-actions">
      <a class="btn btn-primary" href={base}>Ver todos os artigos</a>
      <a class="btn btn-ghost" href={`${base}sobre/`}>Sobre o autor</a>
    </div>
  </section>

  <style>
    .notfound {
      max-width: 640px;
      margin: clamp(60px, 12vw, 140px) auto;
      padding: 0 clamp(20px, 5vw, 56px);
      text-align: center;
    }
    .nf-code {
      font-family: var(--font-mono);
      font-size: clamp(4rem, 16vw, 8rem);
      font-weight: 700;
      line-height: 1;
      letter-spacing: -0.03em;
      color: var(--accent);
      margin: 0;
    }
    .notfound h1 {
      font-size: clamp(1.5rem, 4vw, 2.2rem);
      letter-spacing: -0.01em;
      margin: 10px 0 16px;
    }
    .nf-lead {
      color: var(--muted);
      font-size: 1.05rem;
      line-height: 1.6;
      max-width: 46ch;
      margin: 0 auto 32px;
    }
    .nf-actions {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 12px;
    }
  </style>
</Base>
